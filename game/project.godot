; Engine configuration file.
; It's best edited using the editor UI and not directly,
; but you can also make changes here.

config_version=5

[application]

config/name="SDVGacha"
config/description="SDVGacha — 3D Anime Action-RPG with Hu Tao, Ellen Joe, Cyber & Corrupted Zones"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "Forward Plus", "GL Compatibility")
config/icon="res://icon.png"
config/windows_native_icon="res://icon.ico"
boot_splash/show_image=false
boot_splash/fullsize=false
boot_splash/use_filter=false
boot_splash/bg_color=Color(0, 0, 0, 1)

[autoload]

SoundSynth="*res://scripts/sound_synth.gd"
AccessibilityManager="*res://scripts/accessibility_manager.gd"
DamageNumbers="*res://scripts/damage_numbers.gd"
InventoryManager="*res://scripts/inventory_manager.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=3
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

